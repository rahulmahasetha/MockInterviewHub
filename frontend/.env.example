# ==============================================================================
# MockInterviewHub Frontend Environment Variables Template
# Copy this file to .env or set in your hosting provider (e.g. Vercel dashboard).
# Note: React embeds variables prefixed with REACT_APP_ into the client bundle at build time.
# NEVER store private secrets, database credentials, or secret API keys in the frontend!
# ==============================================================================

# Backend API Base URL
# Development: http://127.0.0.1:3001
# Production: https://<your-backend-service>.onrender.com
REACT_APP_API_URL=http://127.0.0.1:3001
