# ==============================================================================
# MockInterviewHub Backend Environment Variables Template
# Copy this file to .env and replace the placeholder values with your real keys.
# DO NOT commit real secrets or .env to version control.
# ==============================================================================

# Server Configuration
PORT=3001
NODE_ENV=development

# Database Connection (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/mockinterviewhub?retryWrites=true&w=majority

# Security (JWT signing secret - minimum 32 random characters recommended)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long

# AI Providers (At least one valid API key required for live AI interviews)
# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud API Key (https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Default AI Provider ('gemini', 'groq', or 'xai')
AI_PROVIDER=gemini

# Optional: xAI Grok API Key
# XAI_API_KEY=your_xai_api_key_here
# XAI_MODEL=grok-2-latest
